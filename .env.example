# Default: local Dockerfile build, not a moving or nonexistent registry tag.
COMFY_IMAGE=comfyui-docker-pro:local
# ComfyUI stable release used for local builds.
COMFY_REF=v0.40.0
COMFY_PORT=8188
TZ=UTC
COMFY_MEM_LIMIT=12g
COMFY_MEM_RESERVATION=4g
COMFY_SHM_SIZE=1gb
COMFY_PIDS_LIMIT=1024
# Standard Docker Compose only: optionally set --enable-manager-legacy-ui.
COMFY_EXTRA_ARGS=
COMFY_LOG_MAX_SIZE=20m
COMFY_LOG_MAX_FILES=5
