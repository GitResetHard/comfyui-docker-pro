# ZimaOS installation: use an existing writable directory on the /DATA filesystem.
COMFY_DATA=/DATA/AppData/comfyui

# Local custom image built from Dockerfile by: docker compose -f docker-compose.yml up -d --build
# For prebuilt image, set a published GHCR tag and optionally use --no-build.
COMFY_IMAGE=ghcr.io/gitresethard/comfyui-docker-pro:edge
COMFY_REF=master

# Bind to LAN. Do not expose without authentication via trusted reverse proxy.
COMFY_BIND=0.0.0.0
COMFY_PORT=8188
TZ=Europe/Istanbul

# Host RAM limits (NOT GPU VRAM); adjust to ZimaOS machine resources.
COMFY_MEM_LIMIT=12g
COMFY_MEM_RESERVATION=4g
COMFY_SHM_SIZE=1gb
COMFY_PIDS_LIMIT=1024

# Example: --lowvram ; keep blank normally.
COMFY_EXTRA_ARGS=
COMFY_LOG_MAX_SIZE=20m
COMFY_LOG_MAX_FILES=5
