# Default: local Dockerfile build, not a moving or nonexistent registry tag.
COMFY_IMAGE=comfyui-docker-pro:local
# Pin a ComfyUI git commit or release tag for repeatable builds.
COMFY_REF=master
# Standard Compose binds locally by default; ZimaOS Compose defaults to LAN.
# Uncomment to override either:
# COMFY_BIND=127.0.0.1
COMFY_PORT=8188
TZ=UTC
COMFY_MEM_LIMIT=12g
COMFY_MEM_RESERVATION=4g
COMFY_SHM_SIZE=1gb
COMFY_PIDS_LIMIT=1024
# Optional: set to --enable-manager-legacy-ui for the legacy Manager web interface.
COMFY_EXTRA_ARGS=
COMFY_LOG_MAX_SIZE=20m
COMFY_LOG_MAX_FILES=5
# Used only by docker-compose.zimaos.yml
COMFY_DATA=/DATA/AppData/comfyui
